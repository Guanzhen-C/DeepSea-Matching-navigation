\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{research_report}[2026/10/03 Chinese research-report template]

\RequirePackage[a4paper,margin=22mm,headheight=16pt]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs,longtable,array,tabularx}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}

\renewcommand{\contentsname}{目录}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}

\setmainfont{DejaVu Serif}
\setsansfont{DejaVu Sans}
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.3em}
\linespread{1.22}
\setlength{\emergencystretch}{4em}
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{1}
\floatplacement{figure}{H}

\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.75\textheight 0.75\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\definecolor{ReportBlue}{HTML}{17496D}
\definecolor{ReportGray}{HTML}{53616C}
\hypersetup{colorlinks=true,linkcolor=ReportBlue,urlcolor=ReportBlue,citecolor=ReportBlue}

\newcommand{\ReportShortTitle}{研究报告}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{ReportGray}海底地形地貌研究报告}
\fancyhead[R]{\small\color{ReportGray}\ReportShortTitle}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.3pt}

\newcommand{\reporttitle}[3]{%
  \begin{center}
    {\small\sffamily\color{ReportBlue}文献研究报告 · #2}\par\vspace{0.7em}
    {\LARGE\bfseries #1}\par\vspace{0.5em}
    {\small\color{ReportGray}#3}\par
  \end{center}
  \vspace{0.8em}\hrule\vspace{0.8em}
}
